@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root{
  --red:#e5003d;
  --red2:#ff174f;
  --pink:#ff4d78;
  --black:#050505;
  --panel:rgba(14,14,16,.74);
  --line:rgba(255,255,255,.11);
  --text:#f7f7f8;
  --muted:#a8a8ae;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--black);color:var(--text);
  font-family:"Be Vietnam Pro",Arial,sans-serif;overflow-x:hidden;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:40;
  background:radial-gradient(circle at 50% 20%,transparent 0 35%,rgba(0,0,0,.35) 100%);
}
.bg{
  position:fixed;inset:0;z-index:-4;overflow:hidden;background:#050505;
}
.bg-video{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  filter:saturate(1.12) contrast(1.06);
  transform:scale(1.035);
}

.bg:after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(0,0,0,.28),#050505 88%);
}
.noise{
  position:fixed;inset:0;z-index:50;pointer-events:none;opacity:.035;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
}
#cursorGlow{
  position:fixed;width:260px;height:260px;border-radius:50%;pointer-events:none;
  background:radial-gradient(circle,rgba(229,0,61,.12),transparent 65%);
  transform:translate(-50%,-50%);z-index:2;mix-blend-mode:screen;
}
#petals{position:fixed;inset:0;pointer-events:none;z-index:35;overflow:hidden}
.petal{
  position:absolute;top:-30px;width:11px;height:16px;background:#ff6c91;
  border-radius:70% 30% 70% 30%;opacity:.75;filter:drop-shadow(0 0 4px rgba(255,50,100,.5));
  animation:fall linear infinite;
}
@keyframes fall{
  0%{transform:translate3d(0,-40px,0) rotate(0deg)}
  25%{transform:translate3d(55px,28vh,0) rotate(110deg)}
  50%{transform:translate3d(-35px,55vh,0) rotate(220deg)}
  75%{transform:translate3d(65px,80vh,0) rotate(300deg)}
  100%{transform:translate3d(-20px,112vh,0) rotate(420deg)}
}
.topbar{
  width:min(1180px,calc(100% - 48px));margin:0 auto;padding:25px 0;
  display:flex;align-items:center;justify-content:space-between;position:relative;z-index:60;
}
.brand{font-family:"Space Grotesk";font-weight:800;font-size:25px;color:white;text-decoration:none;letter-spacing:-1px}
.brand span{color:var(--red)}
nav{display:flex;gap:30px}
nav a{color:#cfcfd3;text-decoration:none;font-size:13px;transition:.25s}
nav a:hover{color:white}
.menu-btn{display:none;background:none;border:0;color:white;font-size:23px}
main{width:min(1180px,calc(100% - 48px));margin:auto}
.hero{min-height:calc(100vh - 80px);display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:60px;padding:30px 0 100px}
.eyebrow{font-size:11px;letter-spacing:3px;color:#b9b9be;font-weight:700;margin:0 0 20px;display:flex;align-items:center;gap:10px}
.eyebrow span{display:inline-block;width:28px;height:1px;background:var(--red)}
.hero h1{font-family:"Space Grotesk";font-size:clamp(55px,8vw,105px);line-height:.88;letter-spacing:-5px;margin:0 0 28px;font-weight:500}
.hero h1 strong{font-weight:800;color:#fff;text-shadow:0 0 35px rgba(229,0,61,.2)}
.intro{max-width:500px;color:#b7b7bd;line-height:1.8;font-size:15px}
.hero-actions{display:flex;gap:12px;margin-top:35px}
.btn{padding:14px 21px;border-radius:100px;text-decoration:none;border:1px solid var(--line);font:600 13px "Be Vietnam Pro";cursor:pointer;transition:.25s}
.btn.primary{background:var(--red);color:#fff;border-color:var(--red);box-shadow:0 10px 35px rgba(229,0,61,.24)}
.btn.primary:hover{transform:translateY(-3px);box-shadow:0 14px 42px rgba(229,0,61,.36)}
.btn.ghost{background:rgba(255,255,255,.04);color:#eee}
.btn.ghost:hover{background:rgba(255,255,255,.09);transform:translateY(-3px)}
.hero-visual{height:650px;position:relative;display:flex;align-items:center;justify-content:center}
.avatar-wrap{width:min(470px,80vw);aspect-ratio:1;border-radius:50%;position:relative;transform-style:preserve-3d;transition:transform .15s ease;z-index:2}
.avatar{width:100%;height:100%;object-fit:cover;border-radius:50%;border:1px solid rgba(255,255,255,.2);box-shadow:0 0 0 15px rgba(255,255,255,.025),0 35px 100px rgba(0,0,0,.65),0 0 80px rgba(229,0,61,.18)}
.avatar-ring{position:absolute;inset:-20px;border:1px solid rgba(255,55,100,.35);border-radius:50%;animation:spin 16s linear infinite}
.avatar-ring:after{content:"";position:absolute;width:9px;height:9px;background:var(--red);border-radius:50%;top:15%;left:6%;box-shadow:0 0 20px var(--red)}
@keyframes spin{to{transform:rotate(360deg)}}
.orbit{position:absolute;border:1px solid rgba(255,255,255,.08);border-radius:50%;width:560px;height:560px}
.orbit-1{animation:spin 25s linear infinite}
.orbit-2{width:680px;height:680px;border-style:dashed;opacity:.4;animation:spin 35s linear infinite reverse}
.floating-tag{position:absolute;z-index:4;background:rgba(8,8,9,.8);border:1px solid var(--line);backdrop-filter:blur(14px);padding:10px 14px;border-radius:9px;font:600 10px "Space Grotesk";letter-spacing:2px;box-shadow:0 15px 35px rgba(0,0,0,.35)}
.tag-1{top:16%;right:5%;color:#ff6b8d}
.tag-2{bottom:16%;left:5%;color:#ddd}
.section{padding:115px 0}
.section-heading h2{font-family:"Space Grotesk";font-size:clamp(42px,6vw,75px);line-height:.95;letter-spacing:-3px;margin:0 0 50px;font-weight:600}
.section-heading h2 em{font-style:normal;color:#77777d}
.info-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:18px}
.info-card{min-height:310px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(20,20,22,.82),rgba(7,7,8,.68));backdrop-filter:blur(14px);padding:28px;border-radius:20px;position:relative;overflow:hidden;transition:transform .18s ease,border-color .3s,box-shadow .3s}
.info-card:hover{border-color:rgba(255,50,90,.45);box-shadow:0 25px 70px rgba(0,0,0,.35)}
.info-card:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-80px;bottom:-80px;background:rgba(229,0,61,.12);filter:blur(10px)}
.card-icon{font-size:22px;color:var(--red);margin-bottom:45px}
.card-label{font-size:10px;letter-spacing:2px;color:#8e8e95;font-weight:700;margin:0 0 13px}
.info-card h3{font-family:"Space Grotesk";font-size:35px;line-height:1.02;margin:0 0 18px;letter-spacing:-1.5px}
.info-card h3 span{color:#a9a9ae}
.muted,.quote{color:#85858c;font-size:13px;line-height:1.7}
.progress{height:4px;background:#242428;border-radius:10px;overflow:hidden;margin:30px 0 14px}
.progress i{display:block;width:72%;height:100%;background:linear-gradient(90deg,var(--red),#ff6388);animation:progress 1.6s ease both}
@keyframes progress{from{width:0}to{width:72%}}
.mini-row{display:flex;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.07);font-size:12px}
.mini-row b{color:#77777d;font-weight:500}.mini-row span{text-align:right;color:#ddd}
.player{display:grid;grid-template-columns:280px 1fr 240px;gap:40px;align-items:center;border:1px solid var(--line);background:rgba(10,10,11,.78);backdrop-filter:blur(18px);padding:35px;border-radius:24px}
.disc-area{display:flex;flex-direction:column;align-items:center;gap:22px}
.disc{width:220px;height:220px;border-radius:50%;background:
  radial-gradient(circle at 50% 50%,#111 0 7%,#e5003d 7.5% 8%,#121212 8.5% 11%,transparent 11.5%),
  repeating-radial-gradient(circle,#1c1c1f 0 2px,#080809 3px 7px);
  border:10px solid #101012;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(229,0,61,.12)}
.disc.playing{animation:spin 4s linear infinite}
.disc-hole{position:absolute}
.sound-wave{height:22px;display:flex;align-items:center;gap:3px}
.sound-wave i{width:3px;height:7px;background:#8e8e94;border-radius:3px}
.player:has(.disc.playing) .sound-wave i{animation:wave .8s ease-in-out infinite alternate}
.sound-wave i:nth-child(2){animation-delay:.1s}.sound-wave i:nth-child(3){animation-delay:.2s}.sound-wave i:nth-child(4){animation-delay:.3s}.sound-wave i:nth-child(5){animation-delay:.4s}
@keyframes wave{to{height:20px;background:var(--red)}}
.player-main h3{font:700 34px "Space Grotesk";margin:0 0 4px}
.player-main p:not(.card-label){font-size:12px;color:#85858c;margin:0}
.progress-wrap{margin:28px 0 16px}
#seek,#volume{accent-color:var(--red);cursor:pointer}
#seek{width:100%}.time{display:flex;justify-content:space-between;color:#77777e;font-size:10px;margin-top:5px}
.controls{display:flex;align-items:center;gap:12px}
.controls button{border:0;background:transparent;color:#ddd;cursor:pointer;font-size:19px;width:34px;height:34px;border-radius:50%;transition:.2s}
.controls button:hover{color:white;background:rgba(255,255,255,.08)}
.controls .play-btn{width:48px;height:48px;background:var(--red);color:white;font-size:16px;box-shadow:0 8px 25px rgba(229,0,61,.25)}
#volume{width:85px}
.playlist{display:flex;flex-direction:column;gap:8px}
.track{display:grid;grid-template-columns:30px 1fr;grid-template-rows:auto auto;text-align:left;background:transparent;border:1px solid transparent;border-radius:12px;padding:12px;cursor:pointer;color:white}
.track span{grid-row:1/3;color:#6c6c73;font:11px "Space Grotesk";padding-top:2px}
.track b{font-size:12px}.track small{font-size:9px;color:#666970;margin-top:4px}
.track.active,.track:hover{background:rgba(255,255,255,.05);border-color:var(--line)}
.track.active span{color:var(--red)}
.music-note{font-size:11px;color:#68686e;margin-top:15px}
.contact-box{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:75px 0}
.contact-box h2{font:600 clamp(45px,6vw,70px) "Space Grotesk";line-height:.95;letter-spacing:-3px;margin:0}
.contact-box h2 em{color:#777;font-style:normal}
.socials{display:flex;flex-direction:column;gap:10px}
.social{display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:12px;padding:16px;border:1px solid transparent;border-radius:14px;color:white;text-decoration:none;transition:.25s}
.social:hover{background:rgba(255,255,255,.045);border-color:var(--line);transform:translateX(6px)}
.social-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;background:#151518;color:#fff;font-weight:700}
.social small,.social b{display:block}.social small{font-size:8px;letter-spacing:2px;color:#666970;margin-bottom:4px}.social b{font-size:12px}
footer{width:min(1180px,calc(100% - 48px));margin:auto;padding:30px 0 45px;display:flex;justify-content:space-between;color:#5f5f65;font:9px "Space Grotesk";letter-spacing:2px}
footer b{color:var(--red)}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s ease}
.reveal.show{opacity:1;transform:none}
@media(max-width:900px){
  nav{display:none}.menu-btn{display:block}
  .hero{grid-template-columns:1fr;padding-top:55px;text-align:center}
  .hero .eyebrow,.hero-actions{justify-content:center}.intro{margin:auto}
  .hero-visual{height:470px}.avatar-wrap{width:330px}.orbit{width:390px;height:390px}.orbit-2{width:470px;height:470px}
  .info-grid{grid-template-columns:1fr}
  .player{grid-template-columns:1fr;text-align:center}.player-main .card-label{justify-content:center}.controls{justify-content:center}
  .playlist{display:grid;grid-template-columns:1fr 1fr;text-align:left}
  .contact-box{grid-template-columns:1fr;gap:30px}
}
@media(max-width:560px){
  .topbar,main,footer{width:min(100% - 28px,1180px)}
  .hero h1{font-size:58px;letter-spacing:-3px}.section{padding:80px 0}
  .hero-visual{height:390px}.avatar-wrap{width:260px}.orbit{width:300px;height:300px}.orbit-2{width:350px;height:350px}
  .floating-tag{font-size:8px}.tag-1{right:0}.tag-2{left:0}
  .player{padding:24px 18px}.disc{width:180px;height:180px}
  .playlist{grid-template-columns:1fr}
  footer{flex-direction:column;gap:10px}
}


/* Add-on personalization layer: existing layout and visual identity remain intact. */
:root{--red:#e5003d;--red2:#ff174f;--pink:#ff4d78}
.topbar-tools{display:flex;align-items:center;gap:12px}
.settings-open{display:inline-flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid var(--line);border-radius:999px;background:rgba(10,10,12,.58);backdrop-filter:blur(12px);color:#eee;font:700 9px "Space Grotesk",sans-serif;letter-spacing:1.5px;cursor:pointer;transition:.25s}
.settings-open:hover{border-color:var(--red);color:white;box-shadow:0 0 24px color-mix(in srgb,var(--red) 20%,transparent)}
.settings-open:first-letter{font-size:15px}
.settings-backdrop{position:fixed;inset:0;z-index:100;display:flex;justify-content:flex-end;background:rgba(0,0,0,.55);backdrop-filter:blur(7px);opacity:0;visibility:hidden;transition:opacity .25s,visibility .25s}
.settings-backdrop.open{opacity:1;visibility:visible}
.settings-panel{width:min(440px,100%);height:100%;overflow:auto;padding:30px 28px 26px;background:rgba(12,12,15,.97);border-left:1px solid rgba(255,255,255,.12);box-shadow:-24px 0 80px rgba(0,0,0,.35);transform:translateX(30px);transition:transform .28s;color:var(--text)}
.settings-backdrop.open .settings-panel{transform:none}
.settings-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:28px}
.settings-heading .eyebrow{margin-bottom:12px}.settings-heading h2{font:600 28px "Space Grotesk",sans-serif;letter-spacing:-1px;margin:0 0 8px}.settings-heading p:not(.eyebrow){color:#888891;font-size:11px;line-height:1.7;margin:0}
.settings-close{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;background:transparent;color:#fff;font-size:25px;cursor:pointer;flex:none}
.setting-field{display:flex;flex-direction:column;gap:10px;margin:0 0 21px;color:#e8e8ec;font-size:12px;font-weight:600}
.setting-field select{width:100%;appearance:none;border:1px solid rgba(255,255,255,.13);border-radius:11px;padding:13px 40px 13px 14px;background:linear-gradient(45deg,transparent 50%,#999 50%) calc(100% - 19px) 50%/5px 5px no-repeat,linear-gradient(135deg,#999 50%,transparent 50%) calc(100% - 14px) 50%/5px 5px no-repeat,#18181c;color:#f7f7f8;font:500 12px "Be Vietnam Pro",sans-serif;outline:none}
.setting-field select:focus{border-color:var(--red)}
.setting-toggles{border:1px solid var(--line);border-radius:13px;padding:4px 14px;margin-bottom:23px}
.setting-toggles label{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:13px 0;color:#dedee2;font-size:12px}.setting-toggles label+label{border-top:1px solid rgba(255,255,255,.07)}
.setting-toggles input{accent-color:var(--red);width:17px;height:17px}
.lrc-field p{font-size:10px;font-weight:400;line-height:1.7;color:#85858e;margin:0}
.lrc-upload{display:inline-flex;align-items:center;justify-content:center;padding:12px 15px;border:1px dashed rgba(255,255,255,.23);border-radius:10px;color:#eee;background:rgba(255,255,255,.035);cursor:pointer;font-size:11px}
.lrc-upload input{display:none}.lrc-field small{font-size:10px;color:#7d7d86;font-weight:400}
.settings-reset{width:100%;border:1px solid rgba(255,255,255,.15);border-radius:11px;padding:13px;background:transparent;color:#ddd;font:600 11px "Be Vietnam Pro",sans-serif;cursor:pointer;transition:.2s}.settings-reset:hover{border-color:var(--red);color:white}
.settings-footnote{font-size:10px;color:#666670;text-align:center;line-height:1.7;margin:14px 0 0}
.lyrics-panel{margin:22px 0 0;padding:24px 28px;border:1px solid var(--line);border-radius:18px;background:rgba(12,12,14,.63);backdrop-filter:blur(15px)}
.lyrics-head{display:flex;align-items:center;gap:12px}.lyrics-dot{width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 15px var(--red)}.lyrics-head .card-label{margin:0 0 5px}.lyrics-head h3{font:600 19px "Space Grotesk",sans-serif;margin:0}.lyrics-track{margin-left:auto;font-size:10px;color:#898992}
.lyrics-content{min-height:58px;padding:22px 0 2px;text-align:center;color:#f0f0f2;font-size:15px;font-weight:600;line-height:1.8;white-space:pre-line}.lyrics-content small{font-size:10px;font-weight:400;color:#777780}
.lyric-line{display:block;opacity:.35;transform:scale(.98);transition:.25s}.lyric-line.active{opacity:1;color:var(--red);transform:scale(1.02);text-shadow:0 0 18px color-mix(in srgb,var(--red) 35%,transparent)}
/* Personal color presets */
body[data-theme="pink"]{--red:#f0529c;--red2:#ff75ba;--pink:#ff8dc8}
body[data-theme="blue"]{--red:#37baff;--red2:#61d1ff;--pink:#85e1ff}
body[data-theme="purple"]{--red:#a855f7;--red2:#c084fc;--pink:#d8a8ff}
body[data-theme="green"]{--red:#2dd4a4;--red2:#4be7bc;--pink:#85f5d3}
body[data-theme="gold"]{--red:#d8ad54;--red2:#f0cb78;--pink:#ffe1a0}
body[data-theme="white"]{--red:#d9dce5;--red2:#fff;--pink:#f4f4fa}
body[data-theme="blue"] #cursorGlow{background:radial-gradient(circle,rgba(55,186,255,.13),transparent 65%)}
body[data-theme="purple"] #cursorGlow{background:radial-gradient(circle,rgba(168,85,247,.13),transparent 65%)}
body[data-theme="green"] #cursorGlow{background:radial-gradient(circle,rgba(45,212,164,.13),transparent 65%)}
body.effects-off #petals{display:none}body.glow-off #cursorGlow{display:none}body.tilt-off .tilt{transform:none!important}
.bg-video.is-hidden{display:none}
#petals .petal.effect-heart{width:auto;height:auto;background:none;border-radius:0;filter:drop-shadow(0 0 4px color-mix(in srgb,var(--red) 55%,transparent))}
#petals .petal.effect-maple{width:13px;height:13px;background:#e86d45;border-radius:2px 80% 2px 80%;filter:drop-shadow(0 0 4px rgba(255,120,50,.3))}
#petals .petal.effect-snow{width:5px;height:5px;background:#fff;border-radius:50%;filter:drop-shadow(0 0 5px #b9e7ff)}
#petals .petal.effect-stars{width:auto;height:auto;background:none;border-radius:0;color:#ffe8a0;filter:drop-shadow(0 0 5px #ffe8a0)}
#petals .petal.effect-embers{width:5px;height:9px;background:#ff8b45;border-radius:50%;filter:drop-shadow(0 0 6px #ff4d20)}
@media(max-width:900px){.settings-open span{display:none}.settings-open{padding:9px 11px}.settings-panel{padding:25px 22px}}
@media(max-width:560px){.topbar-tools{gap:8px}.settings-open{font-size:14px}.lyrics-panel{padding:20px 17px}.lyrics-content{font-size:13px}}

/* Photo label in the rotating vinyl */
.disc { position:relative; overflow:hidden; }
.disc-photo {
  position:absolute;
  z-index:2;
  width:140px;
  height:140px;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  object-fit:cover;
  border-radius:50%;
  border:4px solid #171719;
  box-shadow:0 0 0 2px var(--red), 0 0 22px rgba(229,0,61,.35);
  pointer-events:none;
}
.external-track {
  display:flex;
  width:100%;
  text-align:left;
  color:inherit;
  text-decoration:none;
  cursor:pointer;
}
.external-track:hover { border-color:rgba(255,50,90,.45); }

/* Larger, track-specific record label */
.disc-photo{width:140px;height:140px;max-width:68%;max-height:68%;object-fit:cover;}
@media(max-width:600px){.disc-photo{width:120px;height:120px;}}


/* Feature additions: memory gallery, countdown, guestbook and secret note */
.memory-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.memory-card{padding:0;text-align:left;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:rgba(13,13,16,.72);color:var(--text);cursor:pointer;transition:transform .25s,border-color .25s,box-shadow .25s}
.memory-card:hover{transform:translateY(-5px);border-color:var(--red);box-shadow:0 18px 50px rgba(0,0,0,.28)}
.memory-card img{display:block;width:100%;height:250px;object-fit:cover;transition:transform .45s}.memory-card:hover img{transform:scale(1.04)}
.memory-card span{display:flex;flex-direction:column;gap:6px;padding:15px}.memory-card b{font:600 12px "Space Grotesk",sans-serif}.memory-card small,.section-hint{color:#85858e;font-size:10px;line-height:1.7}.section-hint{margin-top:14px}
.memory-lightbox{position:fixed;inset:0;z-index:120;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:30px;background:rgba(0,0,0,.92);backdrop-filter:blur(12px);opacity:0;visibility:hidden;transition:.25s}.memory-lightbox.open{opacity:1;visibility:visible}.memory-lightbox img{max-width:min(90vw,1000px);max-height:78vh;object-fit:contain;border-radius:12px;box-shadow:0 20px 80px #000}.memory-lightbox p{color:#eee;font-size:13px;margin:0}.memory-lightbox button,.secret-card>button:first-child{position:absolute;right:24px;top:20px;width:42px;height:42px;border:1px solid #555;border-radius:50%;background:#141414;color:#fff;font-size:28px;cursor:pointer}
.countdown-card{display:grid;grid-template-columns:1fr 1.2fr;gap:35px;align-items:center;padding:clamp(24px,5vw,52px);border:1px solid var(--line);border-radius:22px;background:linear-gradient(125deg,rgba(20,20,23,.92),rgba(12,12,14,.72));backdrop-filter:blur(18px)}.countdown-copy h2{font:600 clamp(28px,4vw,42px)/1.15 "Space Grotesk",sans-serif;letter-spacing:-1.6px;margin:10px 0 14px}.countdown-copy h2 em{color:var(--red);font-style:normal}.countdown-copy>p:not(.eyebrow){color:#9999a2;font-size:12px;line-height:1.8}.exam-date-label{display:flex;flex-direction:column;gap:8px;margin-top:22px;color:#aaa;font-size:11px}.exam-date-label input{width:max-content;max-width:100%;color:#fff;background:#18181d;border:1px solid var(--line);padding:10px;border-radius:9px;color-scheme:dark}
.countdown-clock{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.countdown-clock>div{padding:19px 8px;border:1px solid rgba(255,255,255,.1);border-radius:13px;background:rgba(255,255,255,.035);text-align:center}.countdown-clock strong{display:block;color:var(--red);font:600 clamp(23px,3.4vw,39px) "Space Grotesk",sans-serif;letter-spacing:-1px}.countdown-clock span{display:block;margin-top:8px;color:#8d8d96;font-size:8px;letter-spacing:1.5px}.countdown-clock>p{grid-column:1/-1;text-align:center;color:#ddd;font-size:11px;margin:9px 0 0}
.guestbook-form{max-width:700px;padding:24px;border:1px solid var(--line);border-radius:18px;background:rgba(12,12,14,.7);display:grid;gap:17px}.guestbook-form label{display:grid;gap:8px;color:#ddd;font-size:11px}.guestbook-form input,.guestbook-form textarea{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.13);border-radius:10px;padding:13px 14px;background:#17171b;color:#fff;font:12px "Be Vietnam Pro",sans-serif;resize:vertical}.guestbook-form input:focus,.guestbook-form textarea:focus{outline:1px solid var(--red)}.guestbook-form .btn{width:max-content}.guestbook-form .section-hint{margin:0}.guestbook-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:18px}.guest-message{border:1px solid var(--line);border-radius:13px;padding:16px;background:rgba(15,15,18,.68)}.guest-message b{color:var(--red);font-size:11px}.guest-message p{color:#ddd;font-size:12px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere;margin:9px 0}.guest-message time{font-size:9px;color:#777}
.secret-button{position:fixed;right:20px;bottom:20px;z-index:60;display:flex;align-items:center;gap:8px;border:1px solid color-mix(in srgb,var(--red) 65%,transparent);border-radius:999px;padding:12px 15px;background:rgba(10,10,12,.82);color:var(--red);backdrop-filter:blur(14px);font-size:12px;cursor:pointer;box-shadow:0 5px 30px rgba(0,0,0,.28)}.secret-button span{font:700 8px "Space Grotesk",sans-serif;letter-spacing:1.5px}.secret-modal{position:fixed;inset:0;z-index:130;display:grid;place-items:center;padding:22px;background:rgba(0,0,0,.76);backdrop-filter:blur(9px);opacity:0;visibility:hidden;transition:.25s}.secret-modal.open{opacity:1;visibility:visible}.secret-card{position:relative;width:min(460px,100%);box-sizing:border-box;padding:38px 30px 30px;text-align:center;border:1px solid color-mix(in srgb,var(--red) 45%,transparent);border-radius:22px;background:#111114;color:#fff;box-shadow:0 20px 90px rgba(0,0,0,.5)}.secret-card .eyebrow{justify-content:center}.secret-card h2{font:600 26px "Space Grotesk",sans-serif;margin:20px 0 12px}.secret-card>p:not(.eyebrow){color:#aaa;line-height:1.9;font-size:13px;margin-bottom:24px}.secret-card .btn{margin:auto}
@media(max-width:900px){.memory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.countdown-card{grid-template-columns:1fr}.guestbook-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.memory-grid{gap:10px}.memory-card img{height:180px}.memory-card span{padding:12px}.countdown-card{padding:22px 16px;gap:22px}.countdown-clock{gap:5px}.countdown-clock>div{padding:14px 4px}.countdown-clock span{letter-spacing:.7px;font-size:7px}.guestbook-form{padding:17px}.guestbook-list{grid-template-columns:1fr}.secret-button{right:12px;bottom:12px}}

/* New additions: live visualizer, focus timer, future letter, secret quest */
.visualizer-panel{margin-top:18px;padding:18px 22px;border:1px solid var(--line);border-radius:16px;background:rgba(10,10,12,.72);backdrop-filter:blur(14px)}.visualizer-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;color:#888;font-size:10px}.visualizer-heading .card-label{margin:0}.visualizer-heading span:last-child{font-size:10px}#audioVisualizer{display:block;width:100%;height:100px;margin-top:10px}
.focus-card,.future-letter-card,.mission-card{display:grid;grid-template-columns:1.2fr .8fr;gap:28px;padding:30px;border:1px solid var(--line);border-radius:22px;background:rgba(12,12,14,.78);backdrop-filter:blur(15px)}.focus-card h3{font:600 23px "Space Grotesk",sans-serif;margin:10px 0}.focus-hint{color:#999;font-size:12px;line-height:1.8}.pomodoro-time{font:600 clamp(44px,7vw,72px) "Space Grotesk",sans-serif;letter-spacing:-3px;color:var(--red);margin:18px 0}.pomodoro-controls{display:flex;flex-wrap:wrap;gap:9px}.btn.secondary{background:rgba(255,255,255,.06);color:#eee;border:1px solid var(--line);padding:12px 16px;border-radius:999px;cursor:pointer;font-size:11px}.focus-side{display:grid;align-content:center;gap:14px}.focus-side label,.future-letter-card label{display:grid;gap:8px;font-size:11px;color:#bbb}.focus-side input,.future-letter-card input,.future-letter-card textarea{box-sizing:border-box;width:100%;padding:12px 13px;border-radius:10px;border:1px solid var(--line);background:#17171b;color:#fff;font:12px "Be Vietnam Pro",sans-serif}.focus-side p{font-size:12px;line-height:1.8;color:var(--red);margin:4px 0}.future-letter-card{grid-template-columns:1fr;max-width:850px}.future-letter-actions{display:flex;align-items:center;flex-wrap:wrap;gap:14px}.future-letter-actions span{font-size:10px;color:#999}.letter-reveal{padding:18px;border-left:2px solid var(--red);background:rgba(255,255,255,.035);white-space:pre-wrap;color:#eee;font-size:13px;line-height:1.9}.mission-card{grid-template-columns:repeat(3,1fr);align-items:center;text-align:center;gap:12px}.mission-card>span{font-size:10px;color:#777}.mission-star{justify-self:center;width:66px;height:66px;border:1px solid color-mix(in srgb,var(--red) 40%,transparent);border-radius:50%;background:rgba(255,255,255,.035);color:var(--red);font-size:25px;cursor:pointer;transition:.25s}.mission-star.found{background:var(--red);color:#fff;box-shadow:0 0 28px color-mix(in srgb,var(--red) 35%,transparent);transform:scale(1.08)}.mission-card p,.mission-card #missionReward{grid-column:1/-1;color:#aaa;font-size:12px;line-height:1.8}.mission-card #missionReward{color:var(--red);padding:14px;border:1px solid var(--line);border-radius:12px}
@media(max-width:700px){.focus-card{grid-template-columns:1fr;padding:22px 18px}.mission-card{padding:20px 12px}.mission-star{width:52px;height:52px}.visualizer-panel{padding:16px}.future-letter-card{padding:20px 17px}}


/* Mobile performance: preserve layout while reducing costly paint/compositing. */
@media (max-width:700px), (prefers-reduced-motion: reduce){
  .bg-video{filter:none;transform:none;}
  .noise{display:none;}
  .info-card,.player,.lyrics-panel,.settings-open,.settings-panel,.focus-card,.future-letter-card,.mission-card,.guestbook-form,.secret-button,.secret-modal{backdrop-filter:none!important;-webkit-backdrop-filter:none!important;}
  .info-card:after{filter:none;}
  .reveal{transition-duration:.18s;}
  .petal{animation-duration:calc(var(--fall-duration, 12s) * 1.2);}
}

/* Navigation stays visible while scrolling; every feature has its own anchor. */
html{scroll-padding-top:88px;scroll-behavior:smooth}
section[id]{scroll-margin-top:88px}
.topbar{
  position:sticky;top:0;z-index:90;width:100%;box-sizing:border-box;
  margin:0;padding:13px max(24px,calc((100% - 1180px)/2));
  gap:18px;background:rgba(7,7,9,.88);border-bottom:1px solid rgba(255,255,255,.08);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)
}
.topbar nav{flex:1;justify-content:center;align-items:center;flex-wrap:wrap;gap:8px 15px}
.topbar nav a{font-size:11px;white-space:nowrap}
.topbar-tools{flex-shrink:0}
@media(max-width:1100px) and (min-width:901px){
  .topbar{padding-left:20px;padding-right:20px;gap:12px}
  .topbar nav{gap:7px 10px}
  .topbar nav a{font-size:10px}
}
@media(max-width:900px){
  .topbar{padding:12px 16px;}
  .topbar nav{display:none;}
  .topbar nav.nav-open{display:flex;position:absolute;top:100%;left:10px;right:10px;max-height:70vh;overflow-y:auto;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:0;padding:8px;background:rgba(8,8,10,.97);border:1px solid rgba(255,255,255,.12);border-radius:14px;box-shadow:0 18px 45px rgba(0,0,0,.4);}
  .topbar nav.nav-open a{display:block;padding:12px 14px;font-size:13px;border-bottom:1px solid rgba(255,255,255,.06)}
  .topbar nav.nav-open a:last-child{border-bottom:0}
}
@media(max-width:700px){
  .bg-video{display:block!important;opacity:.72;}
  html{scroll-padding-top:72px}
  section[id]{scroll-margin-top:72px}
}


/* Signature navigation refresh: cinematic glass, richer spacing, and clear hover states. */
:root{--accent:#ff4f91;--accent2:#9d72ff;}
.topbar{
  min-height:76px;padding-top:12px;padding-bottom:12px;
  background:linear-gradient(180deg,rgba(10,9,16,.94),rgba(8,7,12,.82));
  border-bottom:1px solid rgba(255,255,255,.09);
  box-shadow:0 12px 36px rgba(0,0,0,.2);
  -webkit-backdrop-filter:blur(18px) saturate(140%);backdrop-filter:blur(18px) saturate(140%);
}
.topbar:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;background:linear-gradient(90deg,transparent,rgba(255,79,145,.48),rgba(157,114,255,.42),transparent);pointer-events:none}
.brand{position:relative;display:inline-flex;align-items:center;justify-content:center;min-width:48px;height:44px;font-size:28px;letter-spacing:-1.8px;text-shadow:0 0 24px rgba(255,79,145,.18)}
.brand:before{content:"";position:absolute;inset:1px -5px;border-radius:14px;background:linear-gradient(135deg,rgba(255,79,145,.12),rgba(157,114,255,.07));border:1px solid rgba(255,255,255,.07);z-index:-1}
.brand span{color:var(--accent);text-shadow:0 0 16px rgba(255,79,145,.7)}
.topbar nav{gap:4px 5px;padding:5px 7px;border:1px solid rgba(255,255,255,.055);border-radius:16px;background:rgba(255,255,255,.025)}
.topbar nav a{position:relative;padding:10px 11px;border-radius:10px;color:#c8c5d0;font-size:12px;font-weight:600;letter-spacing:-.1px;transition:color .22s ease,background .22s ease,transform .22s ease;}
.topbar nav a:hover,.topbar nav a:focus-visible{color:#fff;background:linear-gradient(135deg,rgba(255,79,145,.15),rgba(157,114,255,.12));transform:translateY(-1px);outline:none}
.topbar nav a:focus-visible{box-shadow:0 0 0 2px rgba(255,79,145,.5)}
.topbar-tools{display:flex;align-items:center;gap:10px}
.settings-open{border:1px solid rgba(255,255,255,.13)!important;border-radius:14px!important;background:linear-gradient(135deg,rgba(255,255,255,.075),rgba(255,255,255,.025))!important;box-shadow:inset 0 1px rgba(255,255,255,.06);transition:all .22s ease}
.settings-open:hover{border-color:rgba(255,79,145,.45)!important;box-shadow:0 8px 28px rgba(255,79,145,.12),inset 0 1px rgba(255,255,255,.08);transform:translateY(-1px)}
.menu-btn{width:42px;height:42px;border:1px solid rgba(255,255,255,.14);border-radius:13px;background:rgba(255,255,255,.055);font-size:21px;transition:.2s}
.menu-btn:hover{background:rgba(255,79,145,.14);border-color:rgba(255,79,145,.4)}
@media(min-width:901px){.topbar nav a{font-size:11.5px;padding:10px 9px}}
@media(max-width:1100px) and (min-width:901px){.topbar{gap:12px}.topbar nav{gap:3px;padding:4px}.topbar nav a{font-size:10px;padding:9px 6px}}
@media(max-width:900px){
 .topbar{min-height:68px;padding:10px 16px;}
 .topbar nav.nav-open{top:calc(100% + 9px);left:12px;right:12px;padding:10px;background:linear-gradient(145deg,rgba(17,14,25,.98),rgba(7,7,11,.98));border:1px solid rgba(255,255,255,.13);border-radius:18px;box-shadow:0 24px 65px rgba(0,0,0,.58),0 0 35px rgba(157,114,255,.08);}
 .topbar nav.nav-open a{padding:13px 14px;border-bottom:1px solid rgba(255,255,255,.055);border-radius:10px;font-size:13px}
 .topbar nav.nav-open a:hover{background:linear-gradient(90deg,rgba(255,79,145,.14),rgba(157,114,255,.09));transform:none}
 .menu-btn{display:inline-flex;align-items:center;justify-content:center}
}
@media(prefers-reduced-motion:reduce){.topbar nav a,.settings-open,.menu-btn{transition:none}}
